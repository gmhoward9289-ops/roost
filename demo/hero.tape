Output roost-demo.gif

Set Shell "bash"
Set FontSize 13
Set Width 1400
Set Height 700
Set Padding 14

Hide
Type "export HOME=/tmp/roost-demo-home PATH=$PWD/bin:$PATH && touch /tmp/roost-go && clear"
Enter
Sleep 500ms
Show

Type@120ms "roost"
Sleep 600ms
Enter
Sleep 10.5s

Type "a"
Sleep 4.5s

Type "s"
Sleep 3s

Type "i"
Sleep 1.8s

Type "j"
Sleep 800ms
Type "j"
Sleep 800ms
Type "j"
Sleep 1.5s

Type "x"
Sleep 2.5s
Type "n"
Sleep 1.5s

Escape
Sleep 1.5s

Type "q"
Sleep 1s
